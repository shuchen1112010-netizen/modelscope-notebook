# 云端 agent v4.2 配置模板 —— 复制为 agent_dual.env 并填入实际值
# 命令/回执 topic（建议加随机后缀防猜测，且与旧实例隔离）
DSH_CMD_TOPIC=dsh-cmd-<随机后缀>
DSH_RES_TOPIC=dsh-res-<随机后缀>
NTFY_BASE=https://ntfy.sh
# 备用命令车道：你的 gist ID 与文件名
GH_GIST_ID=<gist_id>
GH_UID=<你的github用户名>
GH_GIST_FILE=cmd.jsonl
# raw 直读轮询间隔（秒）；CDN 无限额，20 秒≈准实时
GH_POLL_INTERVAL=20
# 回执兜底：webhook.site token uuid（ntfy 连续 3 次失败自动转投）
WH_HOOK_ID=<webhook_site_uuid>
